# Copy to .env and fill in. Never commit .env.

# Nebius Token Factory (OpenAI-compatible API)
NEBIUS_API_KEY= your_api_key_here
NEBIUS_BASE_URL= your_base_url_here
# Needed for the sandbox (Token Factory Sandboxes beta)
NEBIUS_PROJECT_ID= your_project_id_here

# Model IDs per role; use whatever Token Factory currently serves.
# fast: test inputs, Hypothesis harnesses (Nano/Super class)
MODEL_FAST= your_model_id_here
# deep: root-cause diagnosis, hints, post-mortem (Ultra class)
MODEL_DEEP= your_model_id_here
# gate: hint-gate leak judge (Super class)
MODEL_GATE= your_model_id_here

# Sandbox: "contree" = Token Factory sandbox; "local" = unisolated subprocess, dev only
SANDBOX_BACKEND=contree
# Image tag built by: cd backend && uv run python scripts/build_sandbox_image.py
SANDBOX_IMAGE=sparring-partner-python:v1
SANDBOX_TIMEOUT_S=60
SANDBOX_MEMORY_MB=512
